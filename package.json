{
  "name": "gridstorm",
  "private": true,
  "version": "0.0.0",
  "description": "Next-generation, framework-agnostic data grid platform",
  "repository": {
    "type": "git",
    "url": "https://github.com/007krcs/grid-data.git"
  },
  "bugs": {
    "url": "https://github.com/007krcs/grid-data/issues"
  },
  "homepage": "https://gridstorm.tekivex.com",
  "author": {
    "name": "GridStorm",
    "url": "https://gridstorm.tekivex.com"
  },
  "license": "MIT",
  "scripts": {
    "build": "pnpm -r --filter='./packages/*' run build",
    "build:core": "pnpm --filter @gridstorm/core run build",
    "build:renderer": "pnpm --filter @gridstorm/dom-renderer run build",
    "build:react": "pnpm --filter @gridstorm/react run build",
    "dev": "pnpm -r --parallel --filter='./packages/*' run dev",
    "test": "vitest",
    "test:run": "vitest run",
    "lint": "eslint 'packages/*/src/**/*.ts' 'packages/*/src/**/*.tsx'",
    "typecheck": "pnpm -r run typecheck",
    "clean": "pnpm -r run clean && rm -rf node_modules",
    "changeset": "changeset",
    "version": "changeset version",
    "publish": "pnpm -r --filter='./packages/*' run build && pnpm verify:publish && changeset publish",
    "publish:alpha": "pnpm -r --filter='./packages/*' run build && pnpm verify:publish && changeset publish --tag alpha",
    "verify:publish": "node scripts/check-no-workspace-refs.cjs",
    "verify:publish:both": "node scripts/check-no-workspace-refs.cjs --both",
    "seo:indexnow": "node scripts/seo/indexnow-submit.cjs",
    "seo:indexnow:all": "node scripts/seo/indexnow-submit.cjs --all",
    "seo:indexnow:dry": "node scripts/seo/indexnow-submit.cjs --dry-run",
    "build:examples": "node examples/build-all.cjs",
    "storybook": "storybook dev -p 6006",
    "build-storybook": "storybook build",
    "storybook:react": "storybook dev -p 6007 --config-dir .storybook-react",
    "build-storybook:react": "storybook build --config-dir .storybook-react --output-dir storybook-static-react",
    "test:e2e": "playwright test -c e2e/playwright.config.ts",
    "test:e2e:ci": "playwright test -c e2e/playwright.config.ts --project=chromium"
  },
  "devDependencies": {
    "@changesets/cli": "^2.31.0",
    "@noble/curves": "^2.2.0",
