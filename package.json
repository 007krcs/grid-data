{
  "name": "gridstorm",
  "private": true,
  "version": "0.0.0",
  "description": "Next-generation, framework-agnostic data grid platform",
  "repository": {
    "type": "git",
    "url": "https://github.com/007krcs/grid-data.git"
  },
  "bugs": {
    "url": "https://github.com/007krcs/grid-data/issues"
  },
  "homepage": "https://gridstorm.dev",
  "author": {
    "name": "GridStorm",
    "url": "https://gridstorm.dev"
  },
  "license": "MIT",
  "scripts": {
    "build": "pnpm -r --filter='./packages/*' run build",
    "build:core": "pnpm --filter @gridstorm/core run build",
    "build:renderer": "pnpm --filter @gridstorm/dom-renderer run build",
    "build:react": "pnpm --filter @gridstorm/react run build",
    "dev": "pnpm -r --parallel --filter='./packages/*' run dev",
    "test": "vitest",
    "test:run": "vitest run",
    "lint": "eslint 'packages/*/src/**/*.ts' 'packages/*/src/**/*.tsx'",
    "typecheck": "pnpm -r run typecheck",
    "clean": "pnpm -r run clean && rm -rf node_modules",
    "changeset": "changeset",
    "version": "changeset version",
    "publish": "pnpm -r --filter='./packages/*' run build && changeset publish",
    "publish:alpha": "pnpm -r --filter='./packages/*' run build && changeset publish --tag alpha",
    "build:examples": "node examples/build-all.cjs",
    "storybook": "storybook dev -p 6006",
    "build-storybook": "storybook build"
  },
  "devDependencies": {
    "@changesets/cli": "^2.27.0",
    "@testing-library/jest-dom": "^6.4.0",
    "@testing-library/react": "^16.0.0",
    "@testing-library/user-event": "^14.5.0",
    "@vitest/coverage-v8": "^2.0.0",
    "eslint": "^9.39.4",
    "eslint-plugin-jsx-a11y": "^6.8.0",
    "eslint-plugin-no-unsanitized": "^4.0.0",
    "eslint-plugin-react-hooks": "^5.0.0",
    "eslint-plugin-security": "^3.0.0",
    "jsdom": "^25.0.0",
    "prettier": "^3.8.2",
    "tsup": "^8.2.0",
    "typescript": "^5.5.0",
    "typescript-eslint": "^8.58.1",
    "vitest": "^2.0.0"
  },
  "engines": {
    "node": ">=18.0.0",
    "pnpm": ">=9.0.0"
  },
  "packageManager": "pnpm@9.15.0"
}
