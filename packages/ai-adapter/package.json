{
  "name": "@gridstorm/ai-adapter",
  "version": "0.1.0",
  "description": "Vendor-neutral AI adapter for GridStorm — wire OpenAI, Anthropic, or any LLM behind a single interface that plugins consume.",
  "type": "module",
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "source": "./src/index.ts",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      },
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/index.cjs"
      }
    }
  },
  "files": [
    "dist",
    "LICENSE.md"
  ],
  "scripts": {
    "build": "tsup",
    "dev": "tsup --watch",
    "typecheck": "tsc --noEmit",
    "clean": "rm -rf dist"
  },
  "devDependencies": {
    "tsup": "^8.2.0",
    "typescript": "^5.5.0"
  },
  "sideEffects": false,
  "publishConfig": {
    "access": "public"
  },
  "license": "MIT",
  "keywords": [
    "gridstorm",
    "ai",
    "llm",
    "openai",
    "anthropic",
    "adapter",
    "vendor-neutral",
    "datagrid"
  ],
  "repository": {
    "type": "git",
    "url": "https://github.com/007krcs/grid-data.git",
    "directory": "packages/ai-adapter"
  },
  "bugs": {
    "url": "https://github.com/007krcs/grid-data/issues"
  },
  "homepage": "https://gridstorm.tekivex.com",
  "author": {
    "name": "GridStorm",
    "url": "https://gridstorm.tekivex.com/"
  },
  "funding": {
    "type": "github",
    "url": "https://github.com/sponsors/gridstorm"
  },
  "engines": {
    "node": ">=18.0.0"
  }
}
