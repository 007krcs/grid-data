{
  "name": "@gridstorm/core",
  "version": "0.1.0",
  "description": "GridStorm core engine — framework-agnostic data grid state management",
  "type": "module",
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      },
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/index.cjs"
      }
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsup",
    "dev": "tsup --watch",
    "typecheck": "tsc --noEmit",
    "clean": "rm -rf dist",
    "docs": "typedoc",
    "docs:watch": "typedoc --watch"
  },
  "devDependencies": {
    "tsup": "^8.2.0",
    "typedoc": "^0.27.0",
    "typedoc-plugin-markdown": "^4.4.0",
    "typescript": "^5.5.0"
  },
  "sideEffects": false,
  "license": "MIT",
  "keywords": [
    "datagrid",
    "data-grid",
    "grid",
    "table",
    "headless",
    "typescript",
    "gridstorm",
    "virtual-scroll",
    "plugin-system"
  ],
  "repository": {
    "type": "git",
    "url": "https://github.com/gridstorm/gridstorm.git",
    "directory": "packages/core"
  },
  "bugs": {
    "url": "https://github.com/gridstorm/gridstorm/issues"
  },
  "homepage": "https://gridstorm.dev",
  "author": {
    "name": "GridStorm",
    "url": "https://gridstorm.dev"
  },
  "funding": {
    "type": "github",
    "url": "https://github.com/sponsors/gridstorm"
  }
}
