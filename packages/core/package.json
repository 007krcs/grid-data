{
  "name": "@gridstorm/core",
  "version": "0.1.1",
  "description": "GridStorm core engine — framework-agnostic data grid state management",
  "type": "module",
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "source": "./src/index.ts",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      },
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/index.cjs"
      }
    }
  },
  "files": [
    "dist",
    "LICENSE.md"
  ],
  "scripts": {
    "build": "tsup",
    "dev": "tsup --watch",
    "typecheck": "tsc --noEmit",
    "clean": "rm -rf dist",
    "docs": "typedoc",
    "docs:watch": "typedoc --watch"
  },
  "devDependencies": {
    "@gridstorm/plugin-editing": "workspace:*",
    "@gridstorm/plugin-filtering": "workspace:*",
    "@gridstorm/plugin-grouping": "workspace:*",
    "@gridstorm/plugin-pagination": "workspace:*",
    "@gridstorm/plugin-selection": "workspace:*",
    "@gridstorm/plugin-sorting": "workspace:*",
    "tsup": "^8.2.0",
    "typedoc": "^0.27.0",
    "typedoc-plugin-markdown": "^4.4.0",
    "typescript": "^5.5.0"
  },
  "sideEffects": false,
  "publishConfig": {
    "access": "public"
  },
  "license": "MIT",
  "keywords": [
    "datagrid",
    "data-grid",
    "grid",
    "table",
    "headless",
    "typescript",
    "gridstorm",
    "virtual-scroll",
    "plugin-system"
  ],
  "repository": {
    "type": "git",
    "url": "https://github.com/007krcs/grid-data.git",
    "directory": "packages/core"
  },
  "bugs": {
    "url": "https://github.com/007krcs/grid-data/issues"
  },
  "homepage": "https://grid-data-analytics-explorer.vercel.app/",
  "author": {
    "name": "GridStorm",
    "url": "https://grid-data-analytics-explorer.vercel.app/"
  },
  "funding": {
    "type": "github",
    "url": "https://github.com/sponsors/gridstorm"
  },
  "engines": {
    "node": ">=18.0.0"
  }
}
