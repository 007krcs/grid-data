    "@gridstorm/plugin-temporal": "workspace:*",
    "@gridstorm/plugin-time-travel": "workspace:*",
    "@gridstorm/plugin-tree-data": "workspace:*",
    "@gridstorm/plugin-validation": "workspace:*",
    "@gridstorm/plugin-yjs-cells": "workspace:*",
    "@gridstorm/react": "workspace:*",
    "@gridstorm/svelte": "workspace:*",
    "@gridstorm/theme-default": "workspace:*",
    "@gridstorm/vue": "workspace:*"
  }
}
