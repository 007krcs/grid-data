    "@gridstorm/plugin-ai-query": "workspace:*",
    "@gridstorm/plugin-anomaly": "workspace:*",
    "@gridstorm/plugin-cell-autocomplete": "workspace:*",
    "@gridstorm/plugin-cell-formula": "workspace:*",
    "@gridstorm/plugin-cell-range": "workspace:*",
    "@gridstorm/plugin-charts": "workspace:*",
    "@gridstorm/plugin-clipboard": "workspace:*",
    "@gridstorm/plugin-clipboard-pro": "workspace:*",
    "@gridstorm/plugin-collab": "workspace:*",
    "@gridstorm/plugin-column-autosize": "workspace:*",
    "@gridstorm/plugin-column-pinning": "workspace:*",
    "@gridstorm/plugin-column-reorder": "workspace:*",
    "@gridstorm/plugin-column-resize": "workspace:*",
    "@gridstorm/plugin-comments": "workspace:*",
    "@gridstorm/plugin-conditional-formatting": "workspace:*",
    "@gridstorm/plugin-context-menu": "workspace:*",
    "@gridstorm/plugin-editing": "workspace:*",
    "@gridstorm/plugin-excel-export": "workspace:*",
    "@gridstorm/plugin-filtering": "workspace:*",
    "@gridstorm/plugin-formula": "workspace:*",
    "@gridstorm/plugin-formula-engine": "workspace:*",
    "@gridstorm/plugin-grouping": "workspace:*",
    "@gridstorm/plugin-intelligence-hub": "workspace:*",
    "@gridstorm/plugin-intent-engine": "workspace:*",
    "@gridstorm/plugin-master-detail": "workspace:*",
    "@gridstorm/plugin-nl-query": "workspace:*",
    "@gridstorm/plugin-pagination": "workspace:*",
    "@gridstorm/plugin-pdf-export": "workspace:*",
    "@gridstorm/plugin-pivoting": "workspace:*",
    "@gridstorm/plugin-presence": "workspace:*",
