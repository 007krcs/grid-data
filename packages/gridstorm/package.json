{
  "name": "gridstorm",
  "version": "0.6.0",
  "description": "GridStorm — The complete data grid platform in one npm install. 100% free, MIT-licensed. Core engine + 45+ plugins (sorting, filtering, grouping, pivoting, formulas, time-travel, CRDT collab, LLM-backed NL query, anomaly detection, more) + React/Vue/Svelte/Angular adapters + theming + i18n + AI adapter + PDF toolkit. No license keys, no enterprise tier, no watermarks.",
  "type": "module",
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      },
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/index.cjs"
      }
    },
    "./react": {
      "import": {
        "types": "./dist/react.d.ts",
        "default": "./dist/react.js"
      },
      "require": {
        "types": "./dist/react.d.cts",
        "default": "./dist/react.cjs"
      }
    },
    "./plugins": {
      "import": {
        "types": "./dist/plugins.d.ts",
        "default": "./dist/plugins.js"
      },
      "require": {
        "types": "./dist/plugins.d.cts",
        "default": "./dist/plugins.cjs"
      }
    },
    "./pdf": {
      "import": {
        "types": "./dist/pdf.d.ts",
        "default": "./dist/pdf.js"
      },
      "require": {
        "types": "./dist/pdf.d.cts",
        "default": "./dist/pdf.cjs"
      }
    },
    "./theme": {
      "import": "./dist/theme.css",
      "require": "./dist/theme.css"
    },
    "./vue": {
      "import": {
        "types": "./dist/vue.d.ts",
        "default": "./dist/vue.js"
      },
      "require": {
        "types": "./dist/vue.d.cts",
        "default": "./dist/vue.cjs"
      }
    },
    "./svelte": {
      "import": {
        "types": "./dist/svelte.d.ts",
        "default": "./dist/svelte.js"
      },
      "require": {
        "types": "./dist/svelte.d.cts",
        "default": "./dist/svelte.cjs"
      }
    },
    "./angular": {
      "import": {
        "types": "./dist/angular.d.ts",
        "default": "./dist/angular.js"
      },
      "require": {
        "types": "./dist/angular.d.cts",
        "default": "./dist/angular.cjs"
      }
    }
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE.md"
  ],
  "sideEffects": false,
  "scripts": {
    "build": "tsup",
    "typecheck": "tsc --noEmit"
  },
  "keywords": [
    "data-grid",
    "datagrid",
    "table",
    "grid",
    "enterprise",
    "virtual-scroll",
    "sorting",
    "filtering",
    "grouping",
    "pivoting",
    "excel-export",
    "pdf",
    "react",
    "typescript",
    "headless",
    "plugin-system",
    "real-time",
    "streaming",
    "ai",
    "analytics"
  ],
  "repository": {
    "type": "git",
    "url": "https://github.com/007krcs/grid-data.git"
  },
  "homepage": "https://gridstorm.tekivex.com/",
  "bugs": {
    "url": "https://github.com/007krcs/grid-data/issues"
  },
  "license": "MIT",
  "publishConfig": {
    "access": "public"
  },
  "peerDependencies": {
    "react": ">=18.0.0",
    "react-dom": ">=18.0.0",
    "vue": ">=3.0.0",
    "svelte": ">=4.0.0",
    "@angular/core": ">=17.0.0"
  },
  "peerDependenciesMeta": {
    "react": {
      "optional": true
    },
    "react-dom": {
      "optional": true
    },
    "vue": {
      "optional": true
    },
    "svelte": {
      "optional": true
    },
    "@angular/core": {
      "optional": true
    }
  },
  "devDependencies": {
    "@gridstorm/ai-adapter": "workspace:*",
    "@gridstorm/angular": "workspace:*",
    "@gridstorm/codemod": "workspace:*",
    "@gridstorm/core": "workspace:*",
    "@gridstorm/dom-renderer": "workspace:*",
    "@gridstorm/i18n": "workspace:*",
    "@gridstorm/license": "workspace:*",
    "@gridstorm/mcp-server": "workspace:*",
    "@gridstorm/pdf-core": "workspace:*",
