{
  "name": "@gridstorm/i18n",
  "version": "0.1.0",
  "description": "Internationalization support for GridStorm",
  "type": "module",
  "main": "dist/index.cjs",
  "module": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "import": { "types": "./dist/index.d.ts", "default": "./dist/index.js" },
      "require": { "types": "./dist/index.d.cts", "default": "./dist/index.cjs" }
    }
  },
  "scripts": {
    "build": "tsup",
    "dev": "tsup --watch"
  },
  "files": ["dist"],
  "keywords": ["gridstorm", "i18n", "internationalization", "rtl"],
  "devDependencies": {
    "typescript": "^5.5.0",
    "tsup": "^8.5.0"
  }
}
