{
  "name": "@gridstorm/i18n",
  "version": "0.1.0",
  "description": "Internationalization support for GridStorm",
  "type": "module",
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      },
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/index.cjs"
      }
    }
  },
  "scripts": {
    "build": "tsup",
    "dev": "tsup --watch"
  },
  "files": [
    "dist",
    "LICENSE.md"
  ],
  "sideEffects": false,
  "publishConfig": {
    "access": "public"
  },
  "license": "MIT",
  "keywords": [
    "gridstorm",
    "i18n",
    "internationalization",
    "rtl"
  ],
  "devDependencies": {
    "typescript": "^5.5.0",
    "tsup": "^8.5.0"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/007krcs/grid-data.git",
    "directory": "packages/i18n"
  },
  "bugs": {
    "url": "https://github.com/007krcs/grid-data/issues"
  },
  "homepage": "https://gridstorm.dev",
  "author": {
    "name": "GridStorm",
    "url": "https://gridstorm.dev"
  },
  "funding": {
    "type": "github",
    "url": "https://github.com/sponsors/gridstorm"
  }
}
