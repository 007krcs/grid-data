{
  "name": "@gridstorm/license",
  "version": "0.1.1",
  "description": "License key validation for GridStorm enterprise plugins",
  "type": "module",
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "source": "./src/index.ts",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      },
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/index.cjs"
      }
    }
  },
  "scripts": {
    "build": "tsup",
    "dev": "tsup --watch"
  },
  "files": [
    "dist",
    "LICENSE.md"
  ],
  "sideEffects": false,
  "publishConfig": {
    "access": "public"
  },
  "license": "MIT",
  "keywords": [
    "gridstorm",
    "license"
  ],
  "devDependencies": {
    "typescript": "^5.5.0",
    "tsup": "^8.5.0"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/007krcs/grid-data.git",
    "directory": "packages/license"
  },
  "bugs": {
    "url": "https://github.com/007krcs/grid-data/issues"
  },
  "homepage": "https://grid-data-analytics-explorer.vercel.app/",
  "author": {
    "name": "GridStorm",
    "url": "https://grid-data-analytics-explorer.vercel.app/"
  },
  "funding": {
    "type": "github",
    "url": "https://github.com/sponsors/gridstorm"
  },
  "engines": {
    "node": ">=18.0.0"
  }
}
