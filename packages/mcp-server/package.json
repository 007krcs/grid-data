{
  "name": "@gridstorm/mcp-server",
  "version": "0.2.0",
  "description": "GridStorm MCP server: expose live data grids to AI agents as Model Context Protocol tools (stdio transport included)",
  "type": "module",
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "bin": {
    "gridstorm-mcp": "./dist/cli.js"
  },
  "types": "./dist/index.d.ts",
  "source": "./src/index.ts",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      },
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/index.cjs"
      }
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsup",
    "dev": "tsup --watch",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@gridstorm/core": "workspace:*",
    "@gridstorm/pdf-core": "workspace:*"
  },
  "devDependencies": {
    "tsup": "^8.2.0",
    "typescript": "^5.5.0",
    "@types/node": "^20.14.0"
  },
  "sideEffects": false,
  "publishConfig": {
    "access": "public"
  },
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/007krcs/grid-data.git",
    "directory": "packages/mcp-server"
  },
  "homepage": "https://gridstorm.tekivex.com",
  "bugs": {
    "url": "https://github.com/007krcs/grid-data/issues"
  },
  "engines": {
    "node": ">=18.0.0"
  },
  "keywords": [
    "gridstorm",
    "data-grid",
    "mcp",
    "mcp-server",
    "model-context-protocol",
    "ai-agent",
    "llm",
    "claude"
  ]
}
