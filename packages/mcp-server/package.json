{
  "name": "@gridstorm/mcp-server",
  "version": "0.1.1",
  "description": "GridStorm MCP server — tool definitions for Claude/LLM integration with grid and PDF APIs",
  "type": "module",
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "source": "./src/index.ts",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      },
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/index.cjs"
      }
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsup",
    "dev": "tsup --watch"
  },
  "dependencies": {
    "@gridstorm/core": "workspace:*",
    "@gridstorm/pdf-core": "workspace:*"
  },
  "devDependencies": {
    "tsup": "^8.2.0",
    "typescript": "^5.5.0"
  },
  "sideEffects": false,
  "publishConfig": {
    "access": "public"
  },
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/007krcs/grid-data.git",
    "directory": "packages/mcp-server"
  },
  "homepage": "https://grid-data-analytics-explorer.vercel.app/",
  "bugs": {
    "url": "https://github.com/007krcs/grid-data/issues"
  },
  "engines": {
    "node": ">=18.0.0"
  }
}
