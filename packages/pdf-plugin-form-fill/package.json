{
  "name": "@gridstorm/pdf-plugin-form-fill",
  "version": "0.1.0",
  "description": "GridStorm PDF smart form fill plugin — detect form fields and auto-fill with validation",
  "type": "module",
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "source": "./src/index.ts",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      },
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/index.cjs"
      }
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsup",
    "dev": "tsup --watch"
  },
  "dependencies": {
    "@gridstorm/pdf-core": "workspace:*"
  },
  "devDependencies": {
    "tsup": "^8.2.0",
    "typescript": "^5.5.0"
  },
  "sideEffects": false,
  "publishConfig": {
    "access": "public"
  },
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/nicktesh/gridstorm.git",
    "directory": "packages/pdf-plugin-form-fill"
  },
  "homepage": "https://gridstorm.dev",
  "bugs": {
    "url": "https://github.com/nicktesh/gridstorm/issues"
  },
  "engines": {
    "node": ">=18.0.0"
  }
}
