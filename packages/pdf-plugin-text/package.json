{
  "name": "@gridstorm/pdf-plugin-text",
  "version": "0.1.0",
  "description": "Text extraction and search plugin for GridStorm PDF",
  "license": "MIT",
  "type": "module",
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsup",
    "dev": "tsup --watch"
  },
  "dependencies": {
    "@gridstorm/pdf-core": "workspace:*"
  },
  "devDependencies": {
    "tsup": "^8.0.0",
    "typescript": "^5.5.0"
  },
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/nicktesh/gridstorm.git",
    "directory": "packages/pdf-plugin-text"
  },
  "homepage": "https://gridstorm.dev",
  "bugs": {
    "url": "https://github.com/nicktesh/gridstorm/issues"
  },
  "engines": {
    "node": ">=18.0.0"
  },
  "sideEffects": false
}
