{
  "name": "@gridstorm/plugin-a11y",
  "version": "0.1.3",
  "description": "GridStorm accessibility plugin — WCAG 2.1 AA compliance with screen reader announcements, skip navigation, and high contrast support",
  "type": "module",
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "source": "./src/index.ts",
  "exports": {
    ".": {
      "import": { "types": "./dist/index.d.ts", "default": "./dist/index.js" },
      "require": { "types": "./dist/index.d.cts", "default": "./dist/index.cjs" }
    }
  },
  "files": ["dist", "LICENSE.md"],
  "scripts": {
    "build": "tsup",
    "dev": "tsup --watch",
    "typecheck": "tsc --noEmit",
    "clean": "rm -rf dist"
  },
  "dependencies": { "@gridstorm/core": "workspace:*" },
  "devDependencies": { "tsup": "^8.2.0", "typescript": "^5.5.0" },
  "sideEffects": false,
  "publishConfig": { "access": "public" },
  "license": "MIT",
  "keywords": ["datagrid", "accessibility", "wcag", "a11y", "aria", "screen-reader", "plugin", "gridstorm"],
  "repository": { "type": "git", "url": "https://github.com/007krcs/grid-data.git", "directory": "packages/plugin-a11y" },
  "bugs": { "url": "https://github.com/007krcs/grid-data/issues" },
  "homepage": "https://gridstorm.tekivex.com",
  "author": { "name": "GridStorm", "url": "https://gridstorm.tekivex.com/" },
  "funding": { "type": "github", "url": "https://github.com/sponsors/gridstorm" },
  "engines": { "node": ">=18.0.0" }
}
