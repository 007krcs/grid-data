{
  "name": "@gridstorm/plugin-aggregation",
  "version": "0.1.0",
  "description": "GridStorm aggregation plugin — aggregate values for grouped rows",
  "type": "module",
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      },
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/index.cjs"
      }
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsup",
    "dev": "tsup --watch",
    "typecheck": "tsc --noEmit",
    "clean": "rm -rf dist"
  },
  "dependencies": {
    "@gridstorm/core": "workspace:*"
  },
  "devDependencies": {
    "tsup": "^8.2.0",
    "typescript": "^5.5.0"
  },
  "sideEffects": false,
  "license": "MIT",
  "keywords": [
    "datagrid",
    "aggregation",
    "sum",
    "avg",
    "plugin",
    "gridstorm"
  ],
  "repository": {
    "type": "git",
    "url": "https://github.com/gridstorm/gridstorm.git",
    "directory": "packages/plugin-aggregation"
  },
  "bugs": {
    "url": "https://github.com/gridstorm/gridstorm/issues"
  },
  "homepage": "https://gridstorm.dev",
  "author": {
    "name": "GridStorm",
    "url": "https://gridstorm.dev"
  },
  "funding": {
    "type": "github",
    "url": "https://github.com/sponsors/gridstorm"
  }
}
