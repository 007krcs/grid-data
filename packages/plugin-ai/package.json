{
  "name": "@gridstorm/plugin-ai",
  "version": "0.1.1",
  "description": "GridStorm AI plugin — natural language queries, anomaly detection, smart suggestions",
  "type": "module",
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "source": "./src/index.ts",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      },
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/index.cjs"
      }
    }
  },
  "files": [
    "dist",
    "LICENSE.md"
  ],
  "scripts": {
    "build": "tsup",
    "dev": "tsup --watch",
    "typecheck": "tsc --noEmit",
    "clean": "rm -rf dist"
  },
  "dependencies": {
    "@gridstorm/core": "workspace:*"
  },
  "devDependencies": {
    "tsup": "^8.2.0",
    "typescript": "^5.5.0"
  },
  "sideEffects": false,
  "publishConfig": {
    "access": "public"
  },
  "license": "MIT",
  "keywords": [
    "datagrid",
    "ai",
    "natural-language",
    "anomaly-detection",
    "smart-grid",
    "plugin",
    "gridstorm"
  ],
  "repository": {
    "type": "git",
    "url": "https://github.com/007krcs/grid-data.git",
    "directory": "packages/plugin-ai"
  },
  "bugs": {
    "url": "https://github.com/007krcs/grid-data/issues"
  },
  "homepage": "https://grid-data-analytics-explorer.vercel.app/",
  "author": {
    "name": "GridStorm",
    "url": "https://grid-data-analytics-explorer.vercel.app/"
  },
  "funding": {
    "type": "github",
    "url": "https://github.com/sponsors/gridstorm"
  },
  "engines": {
    "node": ">=18.0.0"
  }
}
