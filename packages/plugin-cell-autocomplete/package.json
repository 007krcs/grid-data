{
  "name": "@gridstorm/plugin-cell-autocomplete",
  "version": "0.1.0",
  "description": "GridStorm AI cell autocomplete — Copilot-style suggestions while editing cells. Pillar 2.3 of the roadmap.",
  "type": "module",
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "source": "./src/index.ts",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      },
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/index.cjs"
      }
    }
  },
  "files": ["dist", "LICENSE.md"],
  "scripts": {
    "build": "tsup",
    "dev": "tsup --watch",
    "typecheck": "tsc --noEmit",
    "clean": "rm -rf dist"
  },
  "dependencies": {
    "@gridstorm/ai-adapter": "workspace:*",
    "@gridstorm/core": "workspace:*"
  },
  "devDependencies": {
    "tsup": "^8.2.0",
    "typescript": "^5.5.0"
  },
  "sideEffects": false,
  "publishConfig": { "access": "public" },
  "license": "MIT",
  "keywords": ["datagrid", "ai", "autocomplete", "copilot", "llm", "plugin", "gridstorm"],
  "repository": {
    "type": "git",
    "url": "https://github.com/007krcs/grid-data.git",
    "directory": "packages/plugin-cell-autocomplete"
  },
  "homepage": "https://gridstorm.tekivex.com",
  "engines": { "node": ">=18.0.0" }
}
