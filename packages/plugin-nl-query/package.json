{
  "name": "@gridstorm/plugin-nl-query",
  "version": "0.1.1",
  "description": "GridStorm NL Query plugin — parse natural language queries into filter/sort/group commands",
  "private": false,
  "type": "module",
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": "./dist/index.js",
      "require": "./dist/index.cjs",
      "types": "./dist/index.d.ts"
    }
  },
  "files": [
    "dist",
    "LICENSE.md"
  ],
  "scripts": {
    "build": "tsup",
    "dev": "tsup --watch",
    "typecheck": "tsc --noEmit",
    "clean": "rm -rf dist"
  },
  "peerDependencies": {
    "@gridstorm/core": "workspace:*"
  },
  "devDependencies": {
    "@gridstorm/core": "workspace:*",
    "tsup": "^8.2.0",
    "typescript": "^5.5.0"
  },
  "sideEffects": false,
  "publishConfig": {
    "access": "public"
  },
  "license": "MIT",
  "keywords": [
    "datagrid",
    "natural-language",
    "query",
    "filter",
    "plugin",
    "gridstorm"
  ],
  "repository": {
    "type": "git",
    "url": "https://github.com/007krcs/grid-data.git",
    "directory": "packages/plugin-nl-query"
  },
  "bugs": {
    "url": "https://github.com/007krcs/grid-data/issues"
  },
  "homepage": "https://gridstorm.tekivex.com",
  "author": {
    "name": "GridStorm",
    "url": "https://gridstorm.tekivex.com/"
  },
  "engines": {
    "node": ">=18.0.0"
  }
}
