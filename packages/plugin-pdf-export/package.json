{
  "name": "@gridstorm/plugin-pdf-export",
  "version": "0.1.0",
  "description": "GridStorm PDF export plugin — export grid data to PDF with formatting",
  "type": "module",
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "source": "./src/index.ts",
  "exports": {
    ".": {
      "import": { "types": "./dist/index.d.ts", "default": "./dist/index.js" },
      "require": { "types": "./dist/index.d.cts", "default": "./dist/index.cjs" }
    }
  },
  "files": ["dist"],
  "scripts": { "build": "tsup", "dev": "tsup --watch" },
  "dependencies": {
    "@gridstorm/core": "workspace:*"
  },
  "devDependencies": { "tsup": "^8.2.0", "typescript": "^5.5.0" },
  "sideEffects": false,
  "publishConfig": { "access": "public" },
  "license": "MIT"
}
