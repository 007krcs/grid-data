{
  "name": "@gridstorm/plugin-sparklines",
  "version": "0.1.4",
  "description": "GridStorm sparklines plugin — inline SVG sparkline cell renderers (line, bar, area, win-loss)",
  "type": "module",
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "source": "./src/index.ts",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      },
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/index.cjs"
      }
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsup && node ../../scripts/obfuscate.mjs ./dist",
    "dev": "tsup --watch"
  },
  "dependencies": {
    "@gridstorm/core": "workspace:*"
  },
  "devDependencies": {
    "tsup": "^8.2.0",
    "typescript": "^5.5.0"
  },
  "sideEffects": false,
  "publishConfig": {
    "access": "public"
  },
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/007krcs/grid-data.git",
    "directory": "packages/plugin-sparklines"
  },
  "homepage": "https://gridstorm.tekivex.com",
  "bugs": {
    "url": "https://github.com/007krcs/grid-data/issues"
  },
  "engines": {
    "node": ">=18.0.0"
  },
  "keywords": [
    "gridstorm",
    "data-grid",
    "sparklines"
  ]
}
